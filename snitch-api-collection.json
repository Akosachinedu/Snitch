{
	"info": {
		"_postman_id": "snitch-api-collection",
		"name": "Snitch API",
		"description": "API collection for the Snitch application",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:5001/api/auth/register",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5001",
							"path": ["api", "auth", "register"]
						}
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "http://localhost:5001/api/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5001",
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Device Management (Authenticated)",
			"item": [
				{
					"name": "Report Device",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"iPhone 13\",\n    \"type\": \"Smartphone\",\n    \"brand\": \"Apple\",\n    \"model\": \"iPhone 13\",\n    \"color\": \"Black\",\n    \"serialNumber\": \"IP13BLK123\",\n    \"lastLocation\": \"Coffee Shop\",\n    \"phoneNumber\": \"1234567890\",\n    \"email\": \"testuser@example.com\"\n}"
						},
						"url": {
							"raw": "http://localhost:5001/api/devices/report",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5001",
							"path": ["api", "devices", "report"]
						}
					}
				},
				{
					"name": "Get All Devices",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:5001/api/devices",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5001",
							"path": ["api", "devices"]
						}
					}
				},
				{
					"name": "Update Device",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"iPhone 13 Pro\",\n    \"type\": \"Smartphone\",\n    \"status\": \"Found\"\n}"
						},
						"url": {
							"raw": "http://localhost:5001/api/devices/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5001",
							"path": ["api", "devices", "1"]
						}
					}
				},
				{
					"name": "Delete Device",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:5001/api/devices/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5001",
							"path": ["api", "devices", "1"]
						}
					}
				}
			]
		},
		{
			"name": "Guest Endpoints",
			"item": [
				{
					"name": "Report Device (Guest)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"MacBook Pro\",\n    \"type\": \"Laptop\",\n    \"brand\": \"Apple\",\n    \"model\": \"M1 Pro\",\n    \"color\": \"Space Gray\",\n    \"serialNumber\": \"MBP2023SG\",\n    \"lastLocation\": \"Library\",\n    \"phoneNumber\": \"0987654321\",\n    \"email\": \"guest@example.com\"\n}"
						},
						"url": {
							"raw": "http://localhost:5001/api/guest/report",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5001",
							"path": ["api", "guest", "report"]
						}
					}
				},
				{
					"name": "Search Device",
					"request": {
						"method": "GET",
						"url": {
							"raw": "http://localhost:5001/api/guest/search?serialNumber=MBP2023SG",
							"protocol": "http",
							"host": ["localhost"],
							"port": "5001",
							"path": ["api", "guest", "search"],
							"query": [
								{
									"key": "serialNumber",
									"value": "MBP2023SG"
								}
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "token",
			"value": "your_jwt_token_here"
		}
	]
} 